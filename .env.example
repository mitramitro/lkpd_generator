# Salin file ini menjadi `.env.local` (atau `.env`) lalu isi key asli.
# Keduanya sudah dikecualikan di .gitignore — jangan pernah commit key.
GEMINI_API_KEY=

# Opsional: ganti model default (tanpa isi, dipakai 'gemini-flash-latest').
# Contoh model yang tersedia saat ini: gemini-3.6-flash, gemini-flash-latest.
#GEMINI_MODEL=
